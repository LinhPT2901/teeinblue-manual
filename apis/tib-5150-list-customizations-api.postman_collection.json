{
  "info": {
    "name": "TIB-5150 List Customizations API Tests",
    "description": "Postman collection for GET /customizations with pagination, include_data, filters, and auth coverage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.teeinblue.com/openapi/v1"
    },
    {
      "key": "api_token",
      "value": ""
    },
    {
      "key": "invalid_api_token",
      "value": "invalid-token"
    },
    {
      "key": "forbidden_api_token",
      "value": ""
    },
    {
      "key": "orders_read_api_token",
      "value": ""
    },
    {
      "key": "test_start_date",
      "value": "2025-01-01T00:00:00Z"
    },
    {
      "key": "test_end_date",
      "value": "2025-01-31T23:59:59Z"
    },
    {
      "key": "instance_id_1",
      "value": "123"
    },
    {
      "key": "instance_id_2",
      "value": "456"
    },
    {
      "key": "campaign_id_1",
      "value": "6789"
    },
    {
      "key": "platform_product_id_1",
      "value": "321"
    }
  ],
  "item": [
    {
      "name": "List Customizations API",
      "item": [
        {
          "name": "200 - Default list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ]
            },
            "description": "List customizations with default pagination and default include_data=false behavior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Pagination contract exists\", function () {",
                  "  pm.expect(jsonData).to.have.property(\"links\");",
                  "  pm.expect(jsonData).to.have.property(\"meta\");",
                  "  pm.expect(jsonData).to.have.property(\"data\");",
                  "  pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "if (jsonData.data.length > 0) {",
                  "  pm.test(\"List item has basic customization fields\", function () {",
                  "    const item = jsonData.data[0];",
                  "    pm.expect(item).to.have.property(\"id\");",
                  "    pm.expect(item).to.have.property(\"uuid\");",
                  "    pm.expect(item).to.have.property(\"created_at\");",
                  "    pm.expect(item).to.have.property(\"updated_at\");",
                  "  });",
                  "}",
                  "",
                  "pm.collectionVariables.set(\"next_cursor_from_list\", jsonData.meta && jsonData.meta.next_cursor ? jsonData.meta.next_cursor : \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - include_data=true",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?include_data=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "include_data",
                  "value": "true"
                }
              ]
            },
            "description": "List customizations and include full data/customer_uploads."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response contains data array\", function () {",
                  "  pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "if (jsonData.data.length > 0) {",
                  "  pm.test(\"List item includes full data and customer_uploads\", function () {",
                  "    const item = jsonData.data[0];",
                  "    pm.expect(item).to.have.property(\"data\");",
                  "    pm.expect(item).to.have.property(\"customer_uploads\");",
                  "    pm.expect(item.customer_uploads).to.be.an(\"array\");",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - per_page=1 and cursor pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?per_page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "1"
                }
              ]
            },
            "description": "Get first page with one item and store next_cursor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"data length is at most 1\", function () {",
                  "  pm.expect(jsonData.data.length).to.be.at.most(1);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"next_cursor_from_list\", jsonData.meta && jsonData.meta.next_cursor ? jsonData.meta.next_cursor : \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - next cursor page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?per_page=1&cursor={{next_cursor_from_list}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "1"
                },
                {
                  "key": "cursor",
                  "value": "{{next_cursor_from_list}}"
                }
              ]
            },
            "description": "Use next_cursor from previous request."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"next_cursor_from_list\")) {",
                  "  postman.setNextRequest(null);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - sort created_at desc",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?sort=created_at&sort_type=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "created_at"
                },
                {
                  "key": "sort_type",
                  "value": "desc"
                }
              ]
            },
            "description": "Sort customizations by created_at descending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - date range filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?start_date={{test_start_date}}&end_date={{test_end_date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "start_date",
                  "value": "{{test_start_date}}"
                },
                {
                  "key": "end_date",
                  "value": "{{test_end_date}}"
                }
              ]
            },
            "description": "Filter customizations by created_at date range."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - array filters bracket syntax",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations?instance_ids[]={{instance_id_1}}&instance_ids[]={{instance_id_2}}&campaign_ids[]={{campaign_id_1}}&platform_product_ids[]={{platform_product_id_1}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ],
              "query": [
                {
                  "key": "instance_ids[]",
                  "value": "{{instance_id_1}}"
                },
                {
                  "key": "instance_ids[]",
                  "value": "{{instance_id_2}}"
                },
                {
                  "key": "campaign_ids[]",
                  "value": "{{campaign_id_1}}"
                },
                {
                  "key": "platform_product_ids[]",
                  "value": "{{platform_product_id_1}}"
                }
              ]
            },
            "description": "Filter list by bracket-form array query params."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "401 - Missing authentication",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ]
            },
            "description": "List customizations without Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "401 - Invalid authentication",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{invalid_api_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ]
            },
            "description": "List customizations with invalid token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - orders:read token can access list",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{orders_read_api_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ]
            },
            "description": "List customizations with token that only has orders:read."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response contains data array\", function () {",
                  "  pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - Missing both abilities",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{forbidden_api_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations"
              ]
            },
            "description": "List customizations with authenticated token lacking both customizations:read and orders:read."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
