        },
        {
          "name": "200 - orders:read token can access customization",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{orders_read_api_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customizations/{{uuid_one_upload}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customizations",
                "{{uuid_one_upload}}"
              ]
            },
            "description": "Get customization with a token that only has orders:read."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"UUID matches requested UUID\", function () {",
                  "  pm.expect(jsonData.uuid).to.eql(pm.collectionVariables.get(\"uuid_one_upload\"));",
                  "});",
                  "",
                  "pm.test(\"customer_uploads field exists\", function () {",
                  "  pm.expect(jsonData).to.have.property(\"customer_uploads\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - Missing both abilities",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{forbidden_api_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
