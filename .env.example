# Credentials cho staging teeinblue portal (dùng bởi agent tib-test-data, Playwright tests, Postman scripts)
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.

# User A: account chính
TIB_STAGING_EMAIL=
TIB_STAGING_PASSWORD=
TIB_USER_A_EMAIL=
TIB_USER_A_PASSWORD=

# User B: account thứ hai (test cross-account)
TIB_USER_B_EMAIL=
TIB_USER_B_PASSWORD=

# TIB Open API
# Tạo token bằng POST /api/tokens với {"name":"...","abilities":[...]}
# Giá trị plain CHỈ hiện đúng lúc tạo. Ability hợp lệ:
#   orders:read orders:write customizations:read campaigns:read products:read mcp:access
TIB_API_BASE=https://staging-api.teeinblue.com
TIB_OPENAPI_BASE=https://staging-api.teeinblue.com/openapi/v1
TIB_API_TOKEN=
TIB_ORDERS_READ_TOKEN=
TIB_CUSTOMIZATIONS_READ_TOKEN=
TIB_FORBIDDEN_TOKEN=
TIB_INVALID_TOKEN=invalid-token

# Postman sync (tuỳ chọn): có key thì script tự đẩy token lên environment Postman
# Lấy key tại https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=
POSTMAN_ENV_ID=
